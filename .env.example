# Copy to .env (or .env.development / .env.production) and fill in real values.
# NODE_ENV=production refuses to boot with missing/default secrets (change-me-*, super-secret-*, dev-*).

NODE_ENV=development
PORT=2567
LOG_LEVEL=info
# What the terminal / pm2 prints: none (default; the logs are read in the GM panel, section Logs, and stored in the
# server_logs table), error (errors only) or all (the classic console output). Fatal crashes always reach the terminal.
LOG_CONSOLE=none
# Days the server_logs rows are kept, and the in-memory ring buffer size shown when the database is unavailable.
LOG_RETENTION_DAYS=14
LOG_BUFFER_SIZE=2000
# Days the stored responses of idempotent requests (requestId) are kept.
REQUEST_RESULT_RETENTION_DAYS=7

# Developer-only room actions (e.g. runes/grant). Never allowed in production.
DEV_TOOLS=false

# Auth (use long random strings in production, e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access
ACCESS_TTL_MIN=10
PASSWORD_PEPPER=change-me-pepper
REFRESH_PEPPER=change-me-refresh-pepper
REFRESH_TTL_DAYS=14

# MySQL 8+ / MariaDB 10.5+ (the database is created automatically on start)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=game_arena_db
MYSQL_POOL_SIZE=12
# Apply pending migrations on boot (defaults to true outside production)
DB_AUTO_MIGRATE=true
# Optional: folder with the migration SQL files (default ./drizzle next to the server).
MIGRATIONS_DIR=

# Redis (sessions, caches)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=arena:
# Rate limiter state: memory (single process) | redis (several processes behind a load balancer; default in production)
RATE_LIMIT_STORE=memory

# Retention (days) and archive folder for rotated logs
RETENTION_URTL_DAYS=30
RETENTION_AUDIT_DAYS=90
LOG_EXPORT_DIR=./export

# Account deletion: days between the player's request (account room, request_deletion) and the hard delete by the
# daily purge job. During the grace period login/refresh answer ACCOUNT_DELETION_PENDING and the player can undo it
# with auth cancel_deletion. 0 = delete immediately. Default 30, minimum 0.
ACCOUNT_DELETION_GRACE_DAYS=30


# Admin API (/admin/runtime, /admin/config, /gm) — header x-config-api-key
CONFIG_API_KEY=change-me-admin-key
# Use 32+ random characters; production refuses placeholders and keys shorter than 16 characters.
# Optional: only these addresses may reach /admin/*, the GM panel (/gm) and the dev monitor; everyone else gets 404.
# Comma-separated IPs or CIDR ranges ("localhost" = 127.0.0.1 and ::1). Empty = any address (the key is still required).
# Behind a reverse proxy also set TRUST_PROXY / TRUSTED_PROXIES (below), otherwise every request looks like the proxy.
ADMIN_ALLOWED_IPS=
# Wrong admin keys from one address inside ADMIN_LOCKOUT_SECONDS before that address is locked out (HTTP 429, also for the
# right key) for the same number of seconds.
ADMIN_MAX_FAILED_ATTEMPTS=10
ADMIN_LOCKOUT_SECONDS=300
# Largest HTTP body (bytes) of the JSON routes and the /matchmake endpoints. The config bundle import has its own limits.
HTTP_MAX_BODY_BYTES=65536
# Largest WebSocket message, in bytes.
WS_MAX_PAYLOAD_BYTES=65536
# Simultaneous room connections of ONE account (0 = unlimited): in total, and to the same room type (e.g. battle_pve).
# A client keeps ~21 rooms open and may be on 2 devices, so keep the total above ~45.
MAX_CONNECTIONS_PER_USER=64
MAX_CONNECTIONS_PER_USER_PER_ROOM=8
# CORS: no origin is allowed by default (native clients need none). Comma-separated exact origins for WebGL builds.
CORS_ORIGINS=
CONFIG_DIR=./game_config
# Optional second folder searched for imported config files (default: CONFIG_DIR).
ADMIN_STORAGE_DIR=
MAINTENANCE_MODE=false

# Client address (rate limits, audit). Default: the socket's remote address only; x-forwarded-for / x-real-ip /
# x-client-ip are ignored because any client can send them. Behind a reverse proxy / load balancer set TRUST_PROXY=true
# and list the proxy addresses in TRUSTED_PROXIES (comma separated; empty = trust every peer, only safe when the proxy is
# the only way in). See docs/SECURITY.md "Client address (IP) and proxies".
TRUST_PROXY=false
TRUSTED_PROXIES=

# Real-money purchases (shop items priced as RealMoneyIAP), see docs/IAP.md. Product ids, package name and bundle id
# come from the Unity export (shop.json "iap"); only the secrets live here.
# Demo purchases (Unity ShopCatalog > Iap > Demo Purchases) grant real-money items WITHOUT payment. Outside production
# they follow the export; with NODE_ENV=production they also need IAP_DEMO_PURCHASES=true (a demo server only).
IAP_DEMO_PURCHASES=
# Google Play: service account key with access to the app in the Play Console (path to the JSON file, or the JSON).
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# App Store: Apple root certificates (DER .cer) used to verify StoreKit 2 signed transactions (Apple Root CA - G3 ships
# in ./certs/apple). APPLE_IAP_ONLINE_CHECKS=true also checks certificate revocation online (OCSP).
APPLE_ROOT_CERTS_DIR=./certs/apple
APPLE_IAP_ONLINE_CHECKS=true
