{
  "private": true,
  "name": "turn-based-arena-server",
  "version": "1.0.0",
  "description": "Authoritative Colyseus server for the Turn-Based Arena Unity template",
  "main": "build/index.js",
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "start": "tsx watch src/index.ts",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit && tsc -p test",
    "start:prod": "node build/index.js",
    "clean": "rimraf build",
    "test": "mocha -r tsx \"test/**/*_test.ts\" --exit --timeout 15000",
    "test:e2e": "mocha -r tsx \"test/e2e/*.e2e.ts\" --exit --timeout 60000",
    "pentest:rooms": "node tools/pentest/run.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/database/migrate.cli.ts",
    "db:studio": "drizzle-kit studio",
    "loadtest": "tsx loadtest/example.ts --room presence --numClients 2",
    "pentest:http": "node tools/pentest/http-run.mjs"
  },
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@colyseus/loadtest": "^0.18.3",
    "@colyseus/sdk": "^0.18.5",
    "@colyseus/testing": "^0.18.6",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.1",
    "@types/node": "^25.4.0",
    "drizzle-kit": "^0.31.9",
    "mocha": "^10.2.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@colyseus/core": "^0.18.18",
    "@colyseus/monitor": "^0.18.6",
    "@colyseus/playground": "^0.18.5",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/tools": "^0.18.7",
    "@colyseus/ws-transport": "^0.18.4",
    "adm-zip": "^0.5.16",
    "argon2": "^0.44.0",
    "colyseus": "^0.18.9",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.14.3",
    "ulid": "^3.0.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  }
}
